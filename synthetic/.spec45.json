{
  "workflow_name": "sim_swap_fraud_investigation",
  "description": "End-to-end workflow for detecting, investigating, and resolving SIM swap fraud from initial usage anomaly to customer notification and compensation.",
  "domain": "telco_fraud/sim_swap_fraud",
  "shared_entities": {
    "subscription_id": {
      "type": "string",
      "description": "Unique identifier for the subscriber's mobile subscription (MSISDN or internal ID)."
    },
    "case_id": {
      "type": "string",
      "description": "Unique identifier for a SIM swap fraud investigation case."
    },
    "alert_id": {
      "type": "string",
      "description": "Identifier for an individual fraud alert generated by detection systems."
    },
    "network_event_id": {
      "type": "string",
      "description": "Identifier of a specific network event (e.g., SIM change, location update)."
    },
    "transaction_id": {
      "type": "string",
      "description": "Identifier for a financial or chargeable transaction related to the subscription."
    },
    "customer_contact_channel": {
      "type": "string",
      "enum": [
        "sms",
        "voice_call",
        "email",
        "in_app",
        "push_notification"
      ],
      "description": "Preferred channel used to contact the customer."
    },
    "verification_step": {
      "type": "object",
      "description": "Definition of a single customer verification step in a multi-factor verification flow.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "otp_sms",
            "otp_email",
            "knowledge_based",
            "document_check",
            "in_person",
            "device_binding"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "skipped"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "object",
          "description": "Additional data specific to the verification step (e.g., question IDs, document type)."
        }
      },
      "required": [
        "type",
        "status"
      ]
    },
    "payment_adjustment_id": {
      "type": "string",
      "description": "Identifier for a billing adjustment or refund issued due to confirmed fraud."
    },
    "risk_score": {
      "type": "object",
      "description": "Normalized risk score for SIM swap fraud.",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "band": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "model_version": {
          "type": "string"
        },
        "features": {
          "type": "object",
          "description": "Key feature contributions used in risk scoring.",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "value",
        "band"
      ]
    }
  },
  "functions": [
    {
      "name": "ingest_usage_anomaly_alert",
      "description": "Ingest and normalize a new usage anomaly alert that may indicate SIM swap fraud, linking it to a subscription and creating or updating a fraud case.",
      "stage": "detection",
      "parameters": {
        "type": "object",
        "properties": {
          "raw_alert": {
            "type": "object",
            "description": "Raw alert payload from upstream systems.",
            "properties": {
              "source_system": {
                "type": "string",
                "description": "Originating system of the alert.",
                "enum": [
                  "cdr_monitor",
                  "location_anomaly_engine",
                  "sim_change_monitor",
                  "roaming_system",
                  "third_party_fraud_feed"
                ]
              },
              "external_alert_id": {
                "type": "string",
                "description": "Identifier of the alert in the source system."
              },
              "detected_at": {
                "type": "string",
                "format": "date-time"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ]
              },
              "payload": {
                "type": "object",
                "description": "Arbitrary payload including CDR aggregates, location, device changes, etc."
              }
            },
            "required": [
              "source_system",
              "detected_at",
              "payload"
            ]
          },
          "subscription_hint": {
            "type": "object",
            "description": "Hints to help resolve the subscription identifier if not directly contained.",
            "properties": {
              "msisdn": {
                "type": "string"
              },
              "imsi": {
                "type": "string"
              },
              "imei": {
                "type": "string"
              }
            }
          },
          "linking_options": {
            "type": "object",
            "description": "Control how alerts are grouped into cases.",
            "properties": {
              "merge_window_minutes": {
                "type": "integer",
                "description": "Time window to merge new alerts into an existing open case.",
                "minimum": 5,
                "maximum": 1440
              },
              "merge_by": {
                "type": "string",
                "enum": [
                  "subscription",
                  "device",
                  "network_segment"
                ],
                "description": "Dimension used to group alerts into the same case."
              },
              "create_new_case_if_none": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "required": [
          "raw_alert"
        ]
      },
      "returns": "Normalized alert ID, resolved subscription_id (if found), and associated or newly created case_id."
    },
    {
      "name": "create_sim_swap_case",
      "description": "Explicitly create a new SIM swap fraud case for a subscription, optionally linking existing alerts and seeding initial context.",
      "stage": "case_management",
      "parameters": {
        "type": "object",
        "properties": {
          "subscription_id": {
            "$ref": "#/shared_entities/subscription_id"
          },
          "trigger_source": {
            "type": "string",
            "enum": [
              "agent_manual",
              "batch_job",
              "customer_complaint",
              "auto_detection"
            ]
          },
          "initial_alert_ids": {
            "type": "array",
            "description": "Existing alert_ids that motivated case creation.",
            "items": {
              "type": "string"
            }
          },
          "customer_report": {
            "type": "object",
            "description": "If the case is opened due to a customer complaint.",
            "properties": {
              "reported_at": {
                "type": "string",
                "format": "date-time"
              },
              "channel": {
                "type": "string",
                "enum": [
                  "call_center",
                  "retail_store",
                  "app_chat",
                  "email",
                  "portal"
                ]
              },
              "summary": {
                "type": "string"
              },
              "reference_ticket_id": {
                "type": "string"
              }
            }
          },
          "priority_override": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "Optional manual priority override."
          },
          "created_by": {
            "type": "object",
            "description": "Information about the actor creating the case.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "system",
                  "agent",
                  "api_client"
                ]
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "subscription_id",
          "trigger_source"
        ]
      },
      "returns": "Newly created case_id, initial case status, and any linked alerts."
    },
    {
      "name": "evaluate_sim_swap_risk",
      "description": "Evaluate SIM swap fraud risk for a subscription or case based on recent network activity, customer behavior, and alerts.",
      "stage": "risk_assessment",
      "parameters": {
        "type": "object",
        "properties": {
          "subscription_id": {
            "$ref": "#/shared_entities/subscription_id"
          },
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "lookback": {
            "type": "object",
            "description": "Time window and data sources to consider.",
            "properties": {
              "hours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 720
              },
              "include_network_events": {
                "type": "boolean",
                "default": true
              },
              "include_usage_patterns": {
                "type": "boolean",
                "default": true
              },
              "include_external_feeds": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "context_overrides": {
            "type": "object",
            "description": "Optional context that can override or supplement raw data.",
            "properties": {
              "recent_sim_change": {
                "type": "boolean"
              },
              "customer_travel_status": {
                "type": "string",
                "enum": [
                  "domestic",
                  "roaming",
                  "unknown"
                ]
              },
              "known_device_change": {
                "type": "boolean"
              }
            }
          },
          "model_options": {
            "type": "object",
            "description": "Advanced scoring options.",
            "properties": {
              "model_version": {
                "type": "string"
              },
              "return_feature_contributions": {
                "type": "boolean",
                "default": true
              },
              "thresholds": {
                "type": "object",
                "properties": {
                  "medium": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "high": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "critical": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "subscription_id"
            ]
          },
          {
            "required": [
              "case_id"
            ]
          }
        ]
      },
      "returns": "Computed risk_score, contributing factors, recommended actions, and linkage to case (if provided)."
    },
    {
      "name": "get_case_details",
      "description": "Retrieve full SIM swap fraud case details including alerts, events, risk evaluations, and workflow status.",
      "stage": "case_management",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "include": {
            "type": "array",
            "description": "Additional related entities to include.",
            "items": {
              "type": "string",
              "enum": [
                "alerts",
                "network_events",
                "risk_evaluations",
                "customer_contacts",
                "verification_sessions",
                "billing_impacts",
                "audit_trail"
              ]
            }
          }
        },
        "required": [
          "case_id"
        ]
      },
      "returns": "Complete case object including current status, linked alerts, evaluations, and timelines."
    },
    {
      "name": "lock_subscription_for_investigation",
      "description": "Place provisional controls on a subscription suspected of SIM swap fraud (e.g., block outgoing calls, limit financial transactions).",
      "stage": "control",
      "parameters": {
        "type": "object",
        "properties": {
          "subscription_id": {
            "$ref": "#/shared_entities/subscription_id"
          },
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "controls": {
            "type": "object",
            "description": "Types of controls to apply.",
            "properties": {
              "voice": {
                "type": "string",
                "enum": [
                  "no_change",
                  "block_outgoing",
                  "block_all"
                ],
                "default": "block_outgoing"
              },
              "data": {
                "type": "string",
                "enum": [
                  "no_change",
                  "throttle",
                  "block_all"
                ],
                "default": "throttle"
              },
              "sms": {
                "type": "string",
                "enum": [
                  "no_change",
                  "block_outgoing",
                  "block_all"
                ],
                "default": "block_outgoing"
              },
              "value_added_services": {
                "type": "string",
                "enum": [
                  "no_change",
                  "block_premium",
                  "block_all"
                ],
                "default": "block_premium"
              },
              "financial_limits": {
                "type": "object",
                "description": "Temporary caps on chargeable usage.",
                "properties": {
                  "max_daily_spend": {
                    "type": "number"
                  },
                  "max_single_transaction": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "duration": {
            "type": "object",
            "description": "How long the controls should remain.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "until_manual_release",
                  "fixed_hours"
                ]
              },
              "hours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 168
              }
            },
            "required": [
              "type"
            ]
          },
          "reason": {
            "type": "string"
          },
          "requested_by": {
            "type": "object",
            "properties": {
              "actor_type": {
                "type": "string",
                "enum": [
                  "system",
                  "fraud_analyst",
                  "supervisor"
                ]
              },
              "actor_id": {
                "type": "string"
              }
            },
            "required": [
              "actor_type"
            ]
          }
        },
        "required": [
          "subscription_id",
          "controls",
          "duration"
        ]
      },
      "returns": "Confirmation of applied controls, control_set_id, and expected expiry time."
    },
    {
      "name": "start_customer_verification_session",
      "description": "Initiate a multi-step customer verification flow to confirm whether the SIM swap is legitimate or fraudulent.",
      "stage": "customer_interaction",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "subscription_id": {
            "$ref": "#/shared_entities/subscription_id"
          },
          "contact_channel": {
            "$ref": "#/shared_entities/customer_contact_channel"
          },
          "preferred_language": {
            "type": "string",
            "description": "Locale code for communication templates (e.g., en-US, fr-FR)."
          },
          "verification_plan": {
            "type": "object",
            "description": "Configuration of the verification flow.",
            "properties": {
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/shared_entities/verification_step"
                },
                "description": "Initial blueprint for the steps to execute, all with status 'pending'."
              },
              "max_total_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "timeout_minutes": {
                "type": "integer",
                "minimum": 5,
                "maximum": 1440
              },
              "escalation_policy": {
                "type": "object",
                "description": "Actions to take if verification fails or times out.",
                "properties": {
                  "on_timeout": {
                    "type": "string",
                    "enum": [
                      "auto_block",
                      "keep_controls",
                      "auto_close_low_risk"
                    ]
                  },
                  "on_fail": {
                    "type": "string",
                    "enum": [
                      "notify_fraud_team",
                      "notify_customer_support",
                      "auto_block"
                    ]
                  }
                }
              }
            }
          },
          "initiated_by": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "system",
                  "agent"
                ]
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "case_id"
            ]
          },
          {
            "required": [
              "subscription_id"
            ]
          }
        ]
      },
      "returns": "Verification_session_id, initial step statuses, and communication dispatch status."
    },
    {
      "name": "update_verification_step",
      "description": "Update the result of a single verification step within an ongoing verification session.",
      "stage": "customer_interaction",
      "parameters": {
        "type": "object",
        "properties": {
          "verification_session_id": {
            "type": "string"
          },
          "step_index": {
            "type": "integer",
            "minimum": 0
          },
          "new_status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "attempt_increment": {
            "type": "integer",
            "minimum": 0,
            "description": "How many attempts to add to the step's attempt counter."
          },
          "evidence": {
            "type": "object",
            "description": "Evidence collected during this step.",
            "properties": {
              "otp_result": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "sms",
                      "email"
                    ]
                  },
                  "verified": {
                    "type": "boolean"
                  },
                  "latency_ms": {
                    "type": "integer"
                  }
                }
              },
              "kba_result": {
                "type": "object",
                "properties": {
                  "questions_asked": {
                    "type": "integer"
                  },
                  "correct_answers": {
                    "type": "integer"
                  }
                }
              },
              "document_check": {
                "type": "object",
                "properties": {
                  "document_type": {
                    "type": "string"
                  },
                  "matched_name": {
                    "type": "boolean"
                  },
                  "matched_dob": {
                    "type": "boolean"
                  }
                }
              },
              "agent_notes": {
                "type": "string"
              }
            }
          },
          "completed_by": {
            "type": "object",
            "properties": {
              "actor_type": {
                "type": "string",
                "enum": [
                  "customer",
                  "agent",
                  "system"
                ]
              },
              "actor_id": {
                "type": "string"
              }
            },
            "required": [
              "actor_type"
            ]
          }
        },
        "required": [
          "verification_session_id",
          "step_index",
          "new_status"
        ]
      },
      "returns": "Updated verification session summary, including overall status and remaining steps."
    },
    {
      "name": "analyze_billing_impact",
      "description": "Analyze billing transactions during the suspected fraud window to identify potentially fraudulent charges eligible for adjustment.",
      "stage": "billing_analysis",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "subscription_id": {
            "$ref": "#/shared_entities/subscription_id"
          },
          "analysis_window": {
            "type": "object",
            "description": "Time window for searching billing impacts.",
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              },
              "relative_hours_before_alert": {
                "type": "integer",
                "minimum": 0,
                "maximum": 720
              },
              "relative_hours_after_alert": {
                "type": "integer",
                "minimum": 0,
                "maximum": 720
              }
            }
          },
          "transaction_filters": {
            "type": "object",
            "description": "Filter down to relevant chargeable events.",
            "properties": {
              "types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "voice_call",
                    "sms",
                    "data_session",
                    "content_purchase",
                    "wallet_transfer",
                    "subscription_fee"
                  ]
                }
              },
              "min_amount": {
                "type": "number"
              },
              "exclude_zero_rated": {
                "type": "boolean",
                "default": true
              },
              "currency": {
                "type": "string"
              }
            }
          },
          "classification_options": {
            "type": "object",
            "description": "Configuration of fraud-likelihood classification for each transaction.",
            "properties": {
              "use_behavior_profile": {
                "type": "boolean",
                "default": true
              },
              "use_location_mismatch": {
                "type": "boolean",
                "default": true
              },
              "model_version": {
                "type": "string"
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "case_id"
            ]
          },
          {
            "required": [
              "subscription_id"
            ]
          }
        ]
      },
      "returns": "List of impacted transactions with fraud likelihood, suggested write-off amounts, and total estimated customer impact."
    },
    {
      "name": "propose_billing_adjustments",
      "description": "Generate a structured proposal for billing adjustments or refunds based on analyzed fraudulent transactions.",
      "stage": "billing_resolution",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "impacted_transactions": {
            "type": "array",
            "description": "Transactions deemed potentially fraudulent, including recommended refund amounts.",
            "items": {
              "type": "object",
              "properties": {
                "transaction_id": {
                  "$ref": "#/shared_entities/transaction_id"
                },
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                },
                "fraud_likelihood": {
                  "type": "string",
                  "enum": [
                    "possible",
                    "probable",
                    "confirmed"
                  ]
                },
                "recommended_refund_amount": {
                  "type": "number"
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "transaction_id",
                "amount",
                "currency",
                "fraud_likelihood"
              ]
            }
          },
          "policy_parameters": {
            "type": "object",
            "description": "Operator policies for adjustments.",
            "properties": {
              "max_refund_ratio_for_possible": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "auto_writeoff_threshold": {
                "type": "number",
                "description": "Total amount below which write-off can be auto-approved."
              },
              "rounding_rule": {
                "type": "string",
                "enum": [
                  "round_down_cent",
                  "round_nearest_cent",
                  "round_down_whole"
                ]
              }
            }
          },
          "requested_by": {
            "type": "object",
            "properties": {
              "actor_type": {
                "type": "string",
                "enum": [
                  "system",
                  "fraud_analyst"
                ]
              },
              "actor_id": {
                "type": "string"
              }
            },
            "required": [
              "actor_type"
            ]
          }
        },
        "required": [
          "case_id",
          "impacted_transactions"
        ]
      },
      "returns": "Draft adjustment proposal with per-transaction suggested amounts, total refund, and required approval level."
    },
    {
      "name": "apply_billing_adjustments",
      "description": "Apply approved billing adjustments or refunds to the customer account and generate payment_adjustment_ids.",
      "stage": "billing_resolution",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "adjustment_decisions": {
            "type": "array",
            "description": "List of adjustments to execute, usually from a proposal.",
            "items": {
              "type": "object",
              "properties": {
                "transaction_id": {
                  "$ref": "#/shared_entities/transaction_id"
                },
                "approved_refund_amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                },
                "adjustment_type": {
                  "type": "string",
                  "enum": [
                    "credit_invoice",
                    "wallet_topup",
                    "cash_refund",
                    "bill_discount"
                  ]
                },
                "reason_code": {
                  "type": "string",
                  "enum": [
                    "sim_swap_fraud_confirmed",
                    "goodwill_gesture",
                    "partial_fraud_liability"
                  ]
                },
                "approver": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              },
              "required": [
                "transaction_id",
                "approved_refund_amount",
                "currency",
                "adjustment_type",
                "reason_code"
              ]
            }
          },
          "disbursement_preferences": {
            "type": "object",
            "description": "Preferences on how and when to apply the adjustments.",
            "properties": {
              "apply_immediately": {
                "type": "boolean",
                "default": true
              },
              "group_on_next_bill": {
                "type": "boolean",
                "default": false
              },
              "notify_customer": {
                "type": "boolean",
                "default": true
              },
              "notification_channel": {
                "$ref": "#/shared_entities/customer_contact_channel"
              }
            }
          }
        },
        "required": [
          "case_id",
          "adjustment_decisions"
        ]
      },
      "returns": "List of created payment_adjustment_ids, per-adjustment status, and any billing system reference numbers."
    },
    {
      "name": "finalize_sim_swap_case",
      "description": "Settle a SIM swap fraud case as confirmed or rejected, update subscription controls, and record final disposition.",
      "stage": "resolution",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "final_decision": {
            "type": "string",
            "enum": [
              "fraud_confirmed",
              "fraud_rejected_legitimate_swap",
              "inconclusive_closed",
              "merged_into_other_case"
            ]
          },
          "decision_details": {
            "type": "object",
            "properties": {
              "decided_at": {
                "type": "string",
                "format": "date-time"
              },
              "decided_by": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "justification": {
                "type": "string"
              },
              "linked_case_id": {
                "type": "string",
                "description": "If merged_into_other_case is chosen."
              }
            }
          },
          "post_decision_actions": {
            "type": "object",
            "properties": {
              "release_controls": {
                "type": "boolean",
                "default": true
              },
              "restore_services_profile": {
                "type": "boolean",
                "default": true
              },
              "issue_new_sim_recommendation": {
                "type": "boolean",
                "default": false
              },
              "customer_notification": {
                "type": "object",
                "properties": {
                  "send_notification": {
                    "type": "boolean",
                    "default": true
                  },
                  "channel": {
                    "$ref": "#/shared_entities/customer_contact_channel"
                  },
                  "template_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required": [
          "case_id",
          "final_decision"
        ]
      },
      "returns": "Updated case status, applied post-decision actions, and any generated communication IDs."
    },
    {
      "name": "retry_or_rollback_case_actions",
      "description": "Handle error recovery by retrying failed actions (controls, billing, notifications) or rolling them back where possible.",
      "stage": "error_recovery",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "#/shared_entities/case_id"
          },
          "target_action_group": {
            "type": "string",
            "enum": [
              "subscription_controls",
              "billing_adjustments",
              "customer_notifications",
              "verification_flow"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "retry_failed",
              "full_rollback",
              "simulate"
            ]
          },
          "constraints": {
            "type": "object",
            "description": "Constraints and filters for the recovery operation.",
            "properties": {
              "max_retries": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "only_since": {
                "type": "string",
                "format": "date-time",
                "description": "Limit to actions performed after this timestamp."
              },
              "include_action_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "rollback_policy": {
            "type": "object",
            "description": "Rules for what can be rolled back.",
            "properties": {
              "allow_partial_billing_rollback": {
                "type": "boolean",
                "default": false
              },
              "rollback_controls_if_case_open": {
                "type": "boolean",
                "default": false
              },
              "notify_on_rollback": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "initiated_by": {
            "type": "object",
            "properties": {
              "actor_type": {
                "type": "string",
                "enum": [
                  "system",
                  "fraud_analyst",
                  "support_agent"
                ]
              },
              "actor_id": {
                "type": "string"
              }
            },
            "required": [
              "actor_type"
            ]
          }
        },
        "required": [
          "case_id",
          "target_action_group",
          "mode"
        ]
      },
      "returns": "Summary of retried or rolled-back actions, including successes, failures, and any new follow-up tasks."
    },
    {
      "name": "list_sim_swap_cases",
      "description": "Search or list SIM swap fraud cases with filtering and pagination for monitoring and reporting.",
      "stage": "monitoring",
      "parameters": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "object",
            "properties": {
              "status": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "open",
                    "under_investigation",
                    "awaiting_customer",
                    "resolved",
                    "closed"
                  ]
                }
              },
              "final_decision": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "fraud_confirmed",
                    "fraud_rejected_legitimate_swap",
                    "inconclusive_closed",
                    "merged_into_other_case"
                  ]
                }
              },
              "risk_band": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ]
                }
              },
              "subscription_id": {
                "$ref": "#/shared_entities/subscription_id"
              },
              "created_from": {
                "type": "string",
                "format": "date-time"
              },
              "created_to": {
                "type": "string",
                "format": "date-time"
              },
              "assigned_to": {
                "type": "string",
                "description": "Analyst or team ID."
              }
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200,
                "default": 50
              }
            }
          },
          "sort": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "created_at",
                  "updated_at",
                  "risk_score",
                  "priority"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            }
          }
        }
      },
      "returns": "Paginated list of case summaries with core fields (case_id, subscription_id, risk, status, timestamps)."
    }
  ]
}