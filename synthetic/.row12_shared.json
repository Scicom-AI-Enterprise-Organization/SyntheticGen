{
  "subscriber_id": {
    "type": "string",
    "description": "Unique identifier of the prepaid subscriber (e.g., MSISDN or internal ID)"
  },
  "session_id": {
    "type": "string",
    "description": "Unique identifier for a charging session (e.g., data session, voice call, top-up)"
  },
  "charge_id": {
    "type": "string",
    "description": "Identifier for a specific charge or rated event"
  },
  "transaction_id": {
    "type": "string",
    "description": "Top-up or debit transaction identifier"
  },
  "compliance_case_id": {
    "type": "string",
    "description": "Identifier for a compliance or dispute case"
  },
  "regulatory_region": {
    "type": "string",
    "description": "Regulatory jurisdiction code for the subscriber or session (e.g., 'EU', 'MY', 'US-CA')"
  },
  "money": {
    "type": "object",
    "description": "Monetary value representation",
    "properties": {
      "amount": {
        "type": "number"
      },
      "currency": {
        "type": "string",
        "description": "ISO 4217 currency code"
      }
    },
    "required": [
      "amount",
      "currency"
    ]
  },
  "usage_event": {
    "type": "object",
    "description": "Generic usage event for charging",
    "properties": {
      "event_type": {
        "type": "string",
        "enum": [
          "voice",
          "sms",
          "data",
          "bundle_activation",
          "roaming_data",
          "roaming_voice",
          "content_purchase"
        ]
      },
      "start_time": {
        "type": "string",
        "format": "date-time"
      },
      "end_time": {
        "type": "string",
        "format": "date-time"
      },
      "quantity": {
        "type": "number",
        "description": "Units consumed (seconds, KB, message count, etc.)"
      },
      "unit": {
        "type": "string",
        "enum": [
          "seconds",
          "kilobytes",
          "messages",
          "event"
        ]
      },
      "originating_number": {
        "type": "string"
      },
      "terminating_number": {
        "type": "string"
      },
      "network": {
        "type": "object",
        "properties": {
          "mcc": {
            "type": "string",
            "description": "Mobile country code"
          },
          "mnc": {
            "type": "string",
            "description": "Mobile network code"
          },
          "rat_type": {
            "type": "string",
            "enum": [
              "2G",
              "3G",
              "4G",
              "5G",
              "WIFI"
            ]
          }
        }
      },
      "location": {
        "type": "object",
        "properties": {
          "country_code": {
            "type": "string"
          },
          "cell_id": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        }
      },
      "service_id": {
        "type": "string",
        "description": "Service or offer identifier applied to this event, if any"
      }
    },
    "required": [
      "event_type",
      "start_time",
      "quantity",
      "unit"
    ]
  }
}