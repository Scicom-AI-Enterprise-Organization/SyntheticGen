    {
      "name": "monitor_sd_wan_service_health",
      "description": "Retrieve operational health and performance metrics for an SD-WAN service and its sites.",
      "stage": "monitor",
      "parameters": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "description": "SD-WAN service identifier to monitor."
          },
          "time_range": {
            "type": "object",
            "description": "Time range for metrics retrieval.",
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              },
              "preset": {
                "type": "string",
                "description": "Alternative to from/to, common presets.",
                "enum": [
                  "last_1h",
                  "last_24h",
                  "last_7d",
                  "last_30d"
                ]
              }
            }
          },
          "sites": {
            "type": "array",
            "description": "Optional list of site_ids to filter metrics, otherwise all sites.",
            "items": {
              "type": "string"
            }
          },
          "metric_groups": {
            "type": "array",
            "description": "Metric groups to include.",
            "items": {
              "type": "string",
              "enum": [
                "availability",
                "latency_jitter_loss",
                "bandwidth_utilization",
                "application_performance",
                "security_events"
              ]
            }
          },
          "aggregation": {
            "type": "object",
            "description": "Aggregation options for the metrics.",
            "properties": {
              "interval": {
                "type": "string",
                "enum": [
                  "1m",
                  "5m",
                  "15m",
                  "1h"
                ]
              },
              "functions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "avg",
                    "p95",
                    "max",
                    "min"
                  ]
                }
              }
            }
          },
          "include_alerts": {
            "type": "boolean",
            "description": "If true, include active and recent alerts in the response.",
            "default": true
          }
        },
        "required": [
          "service_id"
        ]
      },
      "returns": "Service health summary, per-site metrics timeseries, and any relevant alerts for the selected time range."
    },
