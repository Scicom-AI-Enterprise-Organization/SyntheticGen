            "properties": {
              "end_time": {
                "type": "string",
                "format": "date-time"
              },
              "device_deactivation_policy": {
                "type": "string",
                "enum": [
                  "all_at_grace_end",
                  "staged_by_policy_profile",
                  "manual"
                ],
                "default": "all_at_grace_end"
              },
              "staged_policy": {
                "type": "object",
                "description": "Detailed staged deactivation when device_deactivation_policy is staged_by_policy_profile.",
                "properties": {
                  "stages": {
