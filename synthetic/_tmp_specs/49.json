              "contract_end",
              "non_payment",
              "migrated_to_new_slice",
              "tenant_request",
              "policy_violation",
              "other"
            ]
          },
          "reason_details": {
            "type": "string"
          },
          "cancellation_mode": {
            "type": "string",
            "enum": [
              "immediate",
              "scheduled",
              "grace_period"
            ],
            "default": "scheduled"
          },
          "scheduled_time": {
