    {
      "name": "cancel_udr_subscription",
      "description": "Cancel a UDR slice subscription, optionally with a grace period and staged deactivation of devices.",
      "stage": "cancel",
      "parameters": {
        "type": "object",
        "properties": {
          "subscription_id": {
            "type": "string"
          },
          "cancel_reason": {
            "type": "string",
