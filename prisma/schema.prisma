generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  // Null for SSO-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  roles    UserRole[]

  invitesSent     Invitation[] @relation("InvitedBy")
  invitesAccepted Invitation[] @relation("AcceptedBy")

  projectsCreated      Project[]            @relation("ProjectCreatedBy")
  projectMemberships   ProjectMember[]
  projectMembersAdded  ProjectMember[]      @relation("ProjectMemberAddedBy")
  providersCreated     ProviderCredential[]
  runsCreated          GenerationRun[]
  datasetVersions      DatasetVersion[]
  exportsCreated       ExportArtifact[]
  benchmarksCreated    Benchmark[]
  benchmarkRunsCreated BenchmarkRun[]
  rubricsCreated       Rubric[]
  auditLog             AuditLogEntry[]
  bootstrapJobs        BootstrapJob[]       @relation("BootstrapJobCreatedBy")
  globalProvidersCreated GlobalProviderCredential[] @relation("GlobalProviderCreatedBy")
  apiKeys              ApiKey[]
}

// Personal access tokens for programmatic API use. A token's bearer can do
// anything the owning user can (same role + project memberships). The raw
// token is shown once at creation; afterwards we only retain the sha256 hash
// (`hashedToken`, unique-indexed for O(1) lookup) plus a short visible
// `prefix` for identification in the UI.
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  // First 12 chars of the raw token (e.g. "sgk_a1b2c3d4")
  // shown alongside the row so users can tell tokens apart in the list.
  prefix      String
  // sha256(rawToken) — never the raw token. UNIQUE so a bearer-auth lookup
  // is one indexed query.
  hashedToken String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  // Soft-revoke: when set, the token is rejected by the bearer middleware.
  // We keep the row so the UI can still show "revoked on …" if we want.
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
  invitations Invitation[]
}

model Invitation {
  id           String    @id @default(cuid())
  token        String    @unique
  // If set, only a user with this email may accept.
  email        String?
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  invitedById  String?
  invitedBy    User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedById String?
  acceptedBy   User?     @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime?
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
}

model Permission {
  id          String  @id @default(cuid())
  // Convention: "<resource>:<action>" e.g. "users:read", "users:write".
  key         String  @unique
  description String?

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// =====================================================================
// SyntheticGen
// =====================================================================

enum ProjectRole {
  OWNER
  EDITOR
  ANNOTATOR
  VIEWER
}

model Project {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  description      String?
  // Default formality applied when LanguageProfile / Persona / Run leave it unset.
  defaultFormality String    @default("formal")
  // External labeling platform connection — used by the "export top %
  // to labeling" flow on benchmark runs. Stored once per project so
  // users don't have to retype the token every export. Encrypted with
  // the same AES-256-GCM helper as provider credentials.
  labelingBaseUrl     String?
  labelingApiKeyEnc   Bytes?
  archivedAt       DateTime?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy        User                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members          ProjectMember[]
  taxonomies       Taxonomy[]
  personas         Persona[]
  languageProfiles LanguageProfile[]
  toolCatalogs     ToolCatalog[]
  templates        PromptTemplate[]
  flows            Flow[]
  providers        ProviderCredential[]
  runs             GenerationRun[]
  conversations    Conversation[]
  datasets         Dataset[]
  benchmarks       Benchmark[]
  rubrics          Rubric[]
  auditLog         AuditLogEntry[]
  knowledgeBase    KnowledgeBaseEntry[]
  knowledgeCrawls  KnowledgeCrawl[]
  bootstrapJobs    BootstrapJob[]
  ensembleGroups   EnsembleJudgeGroup[]

  @@index([createdById])
  @@index([archivedAt])
}

// One-prompt end-to-end project bootstrap. The orchestrator calls AI-assist for
// each entity kind (taxonomy → languages → personas → templates → tools →
// flows), inserts the parsed entities into the project, and appends a stream
// of structured events to `events`. The row is durable so a navigated-away
// user can return and resume the SSE stream from `events.length`.
model BootstrapJob {
  id            String   @id @default(cuid())
  projectId     String
  // queued | running | completed | failed | cancelled
  status        String   @default("queued")
  prompt        String
  providerId    String
  model         String?
  // Sampling knobs shared by every AI-assist call this job makes. Both
  // optional — null means "use the kind default" (0.3 / KIND_MAX_TOKENS on
  // the Python side).
  temperature   Float?
  maxTokens     Int?
  // Which entity kinds to generate. Stored as JSON so we can extend later
  // without a migration: { taxonomy: bool, languages: bool, personas: bool,
  // templates: bool, tools: bool, flows: bool }.
  scope         Json
  // Name of the currently-running step (or last step if status ≠ running).
  currentStep   String?
  // Append-only log of events: { idx, ts, step, kind, payload }.
  // kind is one of: step-start | step-progress | step-done | step-error |
  // inserted | warning | done | error.
  events        Json     @default("[]")
  // Counts of inserted entities per kind, for the summary view.
  inserted      Json     @default("{}")
  // Throttled snapshot of the currently-streaming AI call's accumulated text:
  // `{ step, phaseIndex, text }` while an LLM stream is in flight, NULL
  // between phases. Lets a refreshed page seed the live agent panel with the
  // tokens that already arrived instead of starting blank.
  currentPhaseBuffer Json?
  // Top-level fatal error message if the job died before finishing.
  error         String?
  createdById   String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("BootstrapJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

// Cached result of a "Add from URL" crawl. Pages stay around so the user can
// re-import them later, or re-crawl with the same params without re-fetching
// everything from scratch.
model KnowledgeCrawl {
  id             String    @id @default(cuid())
  projectId      String
  startUrl       String
  depth          Int
  maxPages       Int
  sameOriginOnly Boolean   @default(true)
  // running | completed | failed | cancelled
  status         String    @default("running")
  // Array of { url, depth, title, content, contentChars, truncated, bytes }.
  pages          Json?
  pagesCount     Int       @default(0)
  errorMessage   String?
  createdById    String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
}

// Project-scoped knowledge the generation worker stuffs into the system prompt
// before each conversation. Entries are linked to one or more taxonomy nodes;
// when the run picks a node, all matching KB entries are loaded, joined into a
// "Knowledge base" block, and exposed to the template as {{knowledge}}.
model KnowledgeBaseEntry {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  // Body of the entry. Plain text or markdown — fed to the model as-is.
  content         String
  tags            String[]
  // Which taxonomy nodes this entry is relevant to. Empty array = matches all
  // nodes in the project (catch-all entries).
  taxonomyNodeIds String[]
  sourceUrl       String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, createdAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  addedAt   DateTime    @default(now())
  addedById String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("ProjectMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([projectId, userId])
  @@index([userId])
}

model Taxonomy {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes   TaxonomyNode[]

  @@unique([projectId, name])
}

model TaxonomyNode {
  id         String   @id @default(cuid())
  taxonomyId String
  parentId   String?
  name       String
  slug       String
  // Materialized path "/root/billing/refunds" for prefix queries.
  path       String
  depth      Int
  metadata   Json?
  createdAt  DateTime @default(now())

  taxonomy Taxonomy       @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  parent   TaxonomyNode?  @relation("TaxonomyNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children TaxonomyNode[] @relation("TaxonomyNodeChildren")

  conversations Conversation[]
  runUsages     RunTaxonomyNode[]

  @@unique([taxonomyId, parentId, slug])
  @@index([taxonomyId, path])
}

// First-class language/script/code-switch policy.
// Personas reference one; runs may override.
model LanguageProfile {
  id        String   @id @default(cuid())
  projectId String
  name      String
  // ISO primary language: ms, en, zh, ta.
  primary   String
  // Secondary languages used in code-switching.
  secondary String[]
  // latin | jawi | hans | hant | tamil
  script    String   @default("latin")

  // none | inter-sentential | intra-sentential | rojak
  codeSwitchPolicy String @default("none")
  codeSwitchRate   Float?

  // formal | semi-formal | colloquial | mixed
  register              String   @default("formal")
  // Master switch — when false, particles are stripped/banned.
  allowParticles        Boolean  @default(false)
  // Manglish/Bahasa Rojak particle blocklist applied when allowParticles=false.
  bannedTokens          String[]
  // Regex blocklist for harder cases.
  bannedPatterns        String[]
  // When true, validator additionally rejects spelling shortcuts (tak/je/dah/mcm).
  requireFormalMalay    Boolean  @default(false) @map("requireBahasaBaku")
  // forbid | allowlist | free
  englishLoanwordPolicy String   @default("free")
  // Allowlist of English loanwords permitted when policy=allowlist (e.g. router, bil).
  loanwordAllowlist     String[]

  dialectHints     String[]
  formalityDefault String?
  notes            String?
  isPreset         Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personas Persona[]
  runs     GenerationRun[]

  @@unique([projectId, name])
}

// Malaysia-rich; most fields nullable so partial personas are valid.
model Persona {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?

  // malay | chinese | indian | iban | kadazan | orang-asli | mixed | other
  ethnicity     String?
  // kl | selangor | penang | johor | kelantan | terengganu | kedah | perak | sabah | sarawak | ...
  region        String?
  // urban | suburban | kampung
  urbanity      String?
  // 13-17 | 18-24 | 25-34 | 35-49 | 50-64 | 65+
  ageRange      String?
  gender        String?
  occupation    String?
  // baku | colloquial | manglish | mixed
  formality     String?
  // Flag rather than storing religion; gates halal/prayer-time content.
  religionAware Boolean  @default(false)
  dialectTags   String[]

  languageProfileId String?

  // Overflow (verbosity, politeness, code-switch frequency, common interjections).
  traits Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageProfile LanguageProfile? @relation(fields: [languageProfileId], references: [id], onDelete: SetNull)
  conversations   Conversation[]
  runUsages       RunPersona[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ToolCatalog {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tools   ToolDef[]

  @@unique([projectId, name])
}

model ToolDef {
  id                 String   @id @default(cuid())
  catalogId          String
  // Function name (mykad_lookup, lhdn_efile_status, maybank2u_transfer).
  name               String
  description        String
  parameters         Json
  // Schema for the fake executor to generate realistic responses.
  mockResponseSchema Json?
  // Example response keyed values (e.g. valid MyKad pattern, MYR formatting).
  mockSeed           Json?
  // Synthetic argument examples that satisfy `parameters` JSON Schema. Populated
  // by the AI-assist "tool-def" path; each entry is an object of valid args.
  examples           Json?
  // Tags like mykad, lhdn, maybank, tng, duitnow.
  localePresets      String[]
  // Bumps on schema change so old runs replay deterministically.
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  catalog ToolCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, name, version])
}

model PromptTemplate {
  id               String  @id @default(cuid())
  projectId        String
  name             String
  description      String?
  // system | user-seed | judge | conversation-driver
  kind             String  @default("user-seed")
  body             String
  variableSchema   Json?
  fewShotExamples  Json?
  version          Int     @default(1)
  parentTemplateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTemplate PromptTemplate?  @relation("PromptTemplateLineage", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  forks          PromptTemplate[] @relation("PromptTemplateLineage")
  runs           GenerationRun[]

  @@unique([projectId, name, version])
}

// Conversation flow graph — drives multi-turn synthetic generation along a
// hand-authored DAG (intent → action → branch → terminal). React Flow stores
// the canonical graph in `nodes` + `edges` JSON; the worker walks paths to
// produce structured multi-turn samples.
model Flow {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?
  // Bumps when nodes/edges change in a way that breaks an in-progress run.
  version     Int     @default(1)
  // React Flow node array: [{id, type, position, data}, ...].
  // `type`: start | intent | action | condition | end
  nodes       Json
  // React Flow edge array: [{id, source, target, label?, data?}, ...].
  edges       Json
  // Authoring vs. usable-by-runs. Future runs reference Flow.id; we block
  // run.execute when the flow is unpublished or fails validation.
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, isPublished])
}

model ProviderCredential {
  id                 String   @id @default(cuid())
  projectId          String
  name               String
  // openai | vllm | together | openrouter | sglang | anthropic-proxy | custom
  kind               String   @default("openai")
  baseUrl            String
  // AES-256-GCM ciphertext of the API key (nonce | tag | ct).
  encryptedApiKey    Bytes
  // Last-4 + hash for UI display.
  keyFingerprint     String
  defaultModel       String?
  headers            Json?
  // Reasoning controls. Sent when non-null:
  //   reasoningEffort    -> top-level `reasoning_effort` (OpenAI o-series convention).
  //   chatTemplateKwargs -> sent as `chat_template_kwargs` on every request and as
  //                         `include_reasoning` (mirrors the `enable_thinking` value
  //                         when present so vLLM Qwen3 fully suppresses reasoning).
  reasoningEffort    String?
  chatTemplateKwargs Json?
  // Set when this row was created by importing a GlobalProviderCredential.
  // Tracing only — local edits don't propagate back, and the global being
  // deleted nulls this rather than removing the project copy.
  sourceGlobalProviderId String?
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sourceGlobal   GlobalProviderCredential? @relation(fields: [sourceGlobalProviderId], references: [id], onDelete: SetNull)

  runs               GenerationRun[]
  benchmarkRuns      BenchmarkRun[]  @relation("BenchmarkRunCandidate")
  benchmarkJudgeRuns BenchmarkRun[]  @relation("BenchmarkRunJudge")

  @@unique([projectId, name])
  @@index([sourceGlobalProviderId])
}

// Org-wide provider templates. Admins manage them in /admin/providers and
// project owners import them into their own ProviderCredential rows via the
// "Import from global" action on the project providers page. The import
// copies the encryptedApiKey + every other field, so subsequent local edits
// are independent of the global; re-importing creates a separate row.
model GlobalProviderCredential {
  id                 String   @id @default(cuid())
  name               String   @unique
  kind               String   @default("openai")
  baseUrl            String
  encryptedApiKey    Bytes
  keyFingerprint     String
  defaultModel       String?
  headers            Json?
  reasoningEffort    String?
  chatTemplateKwargs Json?
  archivedAt         DateTime?
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User                 @relation("GlobalProviderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  imports   ProviderCredential[]

  @@index([archivedAt])
}

model GenerationRun {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?
  // draft | queued | running | paused | completed | failed | cancelled
  status      String  @default("draft")

  // Frozen at start: model, sampling params, taxonomy IDs, persona IDs,
  // language profile IDs, difficulty levels, target rows per cell, validation config.
  configSnapshot Json

  providerCredentialId String?
  templateId           String?
  languageProfileId    String?
  model                String
  // temperature, top_p, max_tokens, seed.
  samplingParams       Json
  // { taxonomyNodes: [...], personas: [...], difficulties: [...], rowsPerCell: N }
  gridSpec             Json
  // formal | semi-formal | colloquial | mixed | inherit
  formalityPolicy      String  @default("inherit")

  targetCount     Int       @default(0)
  producedCount   Int       @default(0)
  acceptedCount   Int       @default(0)
  costUsd         Decimal?  @db.Decimal(12, 6)
  tokensIn        BigInt    @default(0)
  tokensOut       BigInt    @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  // Last enqueued cursor for resume.
  checkpointState Json?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  providerCredential ProviderCredential? @relation(fields: [providerCredentialId], references: [id], onDelete: SetNull)
  template           PromptTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  languageProfile    LanguageProfile?    @relation(fields: [languageProfileId], references: [id], onDelete: SetNull)

  jobs          GenerationJob[]
  conversations Conversation[]
  taxonomyNodes RunTaxonomyNode[]
  personas      RunPersona[]

  @@index([projectId, status, createdAt(sort: Desc)])
}

model RunTaxonomyNode {
  runId          String
  taxonomyNodeId String

  run  GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  node TaxonomyNode  @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)

  @@id([runId, taxonomyNodeId])
}

model RunPersona {
  runId     String
  personaId String

  run     GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  persona Persona       @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@id([runId, personaId])
}

// One cell of the grid; resumable unit of work.
model GenerationJob {
  id             String    @id @default(cuid())
  runId          String
  // taxonomy:abc|persona:xyz|difficulty:hard|idx:7 — unique within run.
  cellKey        String
  // pending | running | succeeded | failed | skipped
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?
  // Rendered prompt + tool catalog + persona context for replay.
  inputContext   Json?
  conversationId String?
  tokensIn       Int       @default(0)
  tokensOut      Int       @default(0)
  costUsd        Decimal?  @db.Decimal(10, 6)
  latencyMs      Int?
  startedAt      DateTime?
  finishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run          GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  events       JobEvent[]

  @@unique([runId, cellKey])
  @@index([runId, status])
}

// Step-by-step trace of how a GenerationJob built its conversation: prompt
// rendering, provider request, reasoning/content stream timing, validator
// verdicts. Surfaced in the conversation drawer's Trace tab.
model JobEvent {
  id      String   @id @default(cuid())
  jobId   String
  ts      DateTime @default(now())
  // job.start | context.loaded | prompt.rendered | provider.request |
  // provider.stream.reasoning.start | provider.stream.content.start |
  // provider.response | validator.run | conversation.persisted | job.error
  kind    String
  payload Json?

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, ts])
}

model Conversation {
  id             String  @id @default(cuid())
  projectId      String
  runId          String?
  taxonomyNodeId String?
  personaId      String?

  // Denormalized for query performance — populated by lang-ID validator.
  primaryLanguage String?
  primaryScript   String?
  difficulty      String?
  turnCount       Int     @default(0)
  tokenCount      Int     @default(0)

  // generated | accepted | rejected | flagged | annotated
  status    String  @default("generated")
  // Content hash for cheap exact-dup detection.
  dedupHash String?
  metadata  Json?
  // Frozen snapshot of *the settings that produced this conversation*. Captured
  // at persist time so it survives later edits/cancellations of the parent run.
  //   {
  //     templateId, templateName,
  //     languageProfileId, languageProfileName,
  //     providerCredentialId, providerName, model,
  //     formalityPolicy, register,
  //     samplingParams: { temperature, top_p, max_tokens, seed },
  //     toolIds: [...], toolNames: [...],          # tools the run made available
  //     toolsInvoked: [{ name, count }],           # tools actually called (flow mode)
  //     taxonomyNodeId, taxonomyNodeName, taxonomyNodePath,
  //     personaId, personaName,
  //     difficulty,
  //     flowId, flowName, flowVersion,             # flow-driven runs only
  //     mode: "single-turn" | "flow-driven"
  //   }
  settingsSnapshot Json?

  // Calibration flag — when true, this conversation is part of the
  // hand-rated reference set used to detect judge drift. Calibration
  // conversations are re-judged at the start of every benchmark run
  // and their scores compared against the expected baseline. If the
  // judge's scores drift beyond a threshold, the run is flagged
  // before the user trusts its rankings.
  isCalibration Boolean @default(false)
  // Expected per-axis scores from the human rater for this calibration
  // item. Shape: { axisKey: number, ... } keyed by rubric axis. Used by
  // the drift detector to compare against the judge's output.
  calibrationExpected Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run          GenerationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  taxonomyNode TaxonomyNode?  @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  persona      Persona?       @relation(fields: [personaId], references: [id], onDelete: SetNull)

  messages     Message[]
  validations  Validation[]
  jobs         GenerationJob[]
  versionLinks DatasetVersionConversation[]

  @@index([projectId, status, createdAt(sort: Desc)])
  @@index([runId])
  @@index([dedupHash])
  @@index([projectId, isCalibration])
}

model Message {
  id             String  @id @default(cuid())
  conversationId String
  parentId       String?
  ordinal        Int

  // system | user | assistant | tool
  role                String
  content             String?
  // Captured chain-of-thought for reasoning models (Qwen3-thinking, DeepSeek-R1,
  // OpenAI o-series via some proxies). Not used for validation, kept for tracing.
  reasoningContent    String?
  // [{id, name, arguments}]
  toolCalls           Json?
  toolCallId          String?
  // Dominant language tag (auto-filled by lang-ID validator).
  language            String?
  // [{start, end, lang, script}] for code-switch lineage.
  languageSpans       Json?
  script              String?
  tokenCount          Int?
  latencyMs           Int?
  // Per-turn provenance for mixed-model traces.
  model               String?
  // Full API response for replay/debugging.
  rawProviderResponse Json?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent       Message?     @relation("MessageBranch", fields: [parentId], references: [id], onDelete: SetNull)
  children     Message[]    @relation("MessageBranch")

  @@index([conversationId, ordinal])
  @@index([parentId])
}

model Validation {
  id                    String   @id @default(cuid())
  conversationId        String
  // schema | langid | regex | ngram-repetition | profanity | judge-llm | tool-arg-schema | register-compliance
  validatorKind         String
  // correctness | naturalness | language-fidelity | code-switch-realism | tool-arg-validity | safety | register
  axis                  String
  // pass | fail | warn
  verdict               String
  score                 Float?
  // Diagnostic payload (e.g. detected vs target language, failed JSON Schema path, judge rationale).
  details               Json?
  judgeModel            String?
  judgePromptTemplateId String?
  costUsd               Decimal? @db.Decimal(10, 6)
  latencyMs             Int?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, axis])
}

model Dataset {
  id               String  @id @default(cuid())
  projectId        String
  name             String
  description      String?
  currentVersionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       DatasetVersion[] @relation("DatasetVersions")
  currentVersion DatasetVersion?  @relation("DatasetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
}

model DatasetVersion {
  id              String   @id @default(cuid())
  datasetId       String
  // semver-ish, e.g. 0.1.0
  version         String
  description     String?
  changelog       String?
  frozenAt        DateTime @default(now())
  frozenById      String
  // Diff/lineage chain.
  parentVersionId String?
  // Counts by language/persona/difficulty captured at freeze time.
  stats           Json?

  dataset       Dataset                      @relation("DatasetVersions", fields: [datasetId], references: [id], onDelete: Cascade)
  frozenBy      User                         @relation(fields: [frozenById], references: [id], onDelete: Restrict)
  parentVersion DatasetVersion?              @relation("DatasetVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children      DatasetVersion[]             @relation("DatasetVersionLineage")
  conversations DatasetVersionConversation[]
  exports       ExportArtifact[]
  pinnedBy      Dataset?                     @relation("DatasetCurrentVersion")

  @@unique([datasetId, version])
}

// Explicit join enforces FK; deletion of source conversations is restricted while referenced.
model DatasetVersionConversation {
  datasetVersionId String
  conversationId   String
  addedAt          DateTime @default(now())

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@id([datasetVersionId, conversationId])
}

model ExportArtifact {
  id               String  @id @default(cuid())
  datasetVersionId String
  // openai-jsonl | sharegpt | alpaca | parquet | hf-hub
  format           String
  // local | s3 | hf
  storageKind      String  @default("local")
  storagePath      String
  byteSize         BigInt?
  rowCount         Int?
  checksumSha256   String?
  // building | ready | failed
  status           String  @default("building")
  createdById      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([datasetVersionId, format])
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  projectId   String?
  actorUserId String?
  actorIp     String?
  // project.create | run.start | run.cancel | dataset.freeze | provider.create | provider.delete | export.create | ...
  action      String
  targetKind  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Benchmarks — evaluate existing models against a published or uploaded dataset.
// Counterpart to GenerationRun: those produce data, these consume it to score
// models. The Scicom Function-Call benchmark is the first kind we support.
// ---------------------------------------------------------------------------

model Benchmark {
  id                    String   @id @default(cuid())
  projectId             String
  name                  String
  description           String?
  // Discriminator for what shape of evaluation this benchmark drives.
  //   hf-function-call   — external HuggingFace dataset, tool-call accuracy scoring.
  //   project-chat-replay — replay frozen project-generated conversations against a
  //                         candidate model, score with validators + LLM judge against
  //                         the recorded assistant turns.
  kind                  String   @default("hf-function-call")
  // Source URI:
  //   hf:<org>/<dataset>           e.g. hf:Scicom-intl/Function-Call
  //   file:<storagePath>           uploaded JSONL (slice 2)
  //   project-run:<runId>          replay every accepted conversation from one Run
  //   project-filter               replay a deterministic filter slice; see config
  source                String
  // Splits to evaluate, in load_dataset's `name`/`config` sense:
  //   ["english", "mandarin", "malay"] for Scicom Function-Call.
  // For project-chat-replay benchmarks, this is the list of language buckets
  // detected in the frozen sample (used purely for grouped reporting).
  splits                String[]
  // Cap rows per split for fast smoke runs. Null = full split.
  maxRowsPerSplit       Int?
  // Format-specific knobs.
  //   hf-function-call:    { conversationField, functionsField }
  //   project-chat-replay: { mode: "single-turn" | "multi-turn",
  //                          filter?: { runIds, personaIds, taxonomyNodeIds, status, limit, seed } }
  // Stored loosely so new benchmark kinds don't need a migration.
  config                Json?
  // Snapshot of conversation IDs (project-chat-replay) frozen at creation time
  // so every BenchmarkRun evaluates the same items even if the source filter
  // would now return different rows. Empty for hf-function-call.
  frozenConversationIds String[] @default([])
  // Default rubric for chat-replay scoring. Each run inherits this; the run
  // can override with its own rubricId for one-off experiments.
  defaultRubricId       String?
  // Default ensemble-judge group for "Re-judge with ensemble" on this
  // benchmark's runs. Null = use the project's first ensemble group as
  // fallback, or disable the ensemble button if no groups exist.
  defaultEnsembleGroupId String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  defaultRubric Rubric?        @relation("BenchmarkDefaultRubric", fields: [defaultRubricId], references: [id], onDelete: SetNull)
  defaultEnsembleGroup EnsembleJudgeGroup? @relation("BenchmarkDefaultEnsembleGroup", fields: [defaultEnsembleGroupId], references: [id], onDelete: SetNull)
  runs          BenchmarkRun[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, kind])
}

// ---------------------------------------------------------------------------
// Named groups of ensemble judges. Each group is a list of
// {providerCredentialId, model} pairs the "Re-judge with ensemble" flow
// uses to re-score a subset of a benchmark run with multiple models for
// consensus / disagreement. A project can have many groups (e.g. "Strict
// trio", "Cheap pair", "Validator-style"). Each benchmark picks one as
// its default; runs can override at re-judge time.
// ---------------------------------------------------------------------------

model EnsembleJudgeGroup {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?
  // [{ providerCredentialId, model }, ...]
  judges      Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  benchmarks Benchmark[]    @relation("BenchmarkDefaultEnsembleGroup")
  runs       BenchmarkRun[] @relation("BenchmarkRunEnsembleGroup")

  @@unique([projectId, name])
  @@index([projectId])
}

model BenchmarkRun {
  id                   String @id @default(cuid())
  benchmarkId          String
  // Which provider + model we're scoring (the *candidate*). The benchmark itself
  // doesn't pin a model — that's how multiple runs against the same benchmark compare.
  providerCredentialId String
  model                String
  // queued | running | completed | failed | cancelled
  status               String @default("queued")
  // Replay mode for chat-replay benchmarks:
  //   single-turn  — replay only the first user message, score the candidate's reply.
  //   multi-turn   — feed each recorded user message in order; candidate produces
  //                  each assistant turn; reference assistant turns are NEVER fed back.
  //   function-call — legacy hf-function-call benchmarks (default for backward compat).
  mode                 String @default("function-call")

  // LEGACY single-judge fields. New chat-replay runs use ensembleGroupId
  // instead (groups of size 1 are the "single judge" case). Kept for
  // historical rows. The worker prefers ensembleGroupId when set.
  judgeProviderCredentialId String?
  judgeModel                String?
  // EnsembleJudgeGroup the run scored against. A group of size 1 behaves
  // identically to single-judge; size 2+ produces per-row consensus
  // (median per-axis scores, worst verdict, max disagreement). Null on
  // legacy rows.
  ensembleGroupId           String?
  // Consensus aggregation method when the group has 2+ judges.
  //   "median" (default) — per-axis scores median; worst verdict
  //   "mean"             — per-axis scores mean; worst verdict
  //   "min"              — per-axis scores min;  worst verdict
  consensusMethod           String   @default("median")
  // Snapshot of which rubric this run was scored against. Falls back to the
  // benchmark's defaultRubricId at queue time. Storing it on the run lets us
  // compare apples-to-apples even if the rubric is later edited or deleted.
  rubricId                  String?
  // Sampling controls for the candidate replay. { temperature, top_p, max_tokens, seed }
  samplingParams            Json?

  // Aggregate metrics, keyed by split + an "overall" rollup.
  //   function-call: { splits: {...}, overall: { function_accuracy, parameter_accuracy, ... } }
  //   chat-replay:   { splits: {...}, overall: { axes: { language_fidelity: 4.2, ... },
  //                                              validators: { langid: 0.95, ... },
  //                                              functionCallAccuracy?: 0.83,
  //                                              totalItems, completedItems } }
  metrics Json?

  // Live counters surfaced via SSE.
  totalTurns     Int @default(0)
  completedTurns Int @default(0)
  failedTurns    Int @default(0)

  costUsd   Decimal? @db.Decimal(12, 6)
  tokensIn  BigInt   @default(0)
  tokensOut BigInt   @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?

  // Calibration drift report — populated when the run scores any
  // conversations marked isCalibration=true at the start of the run.
  // Shape:
  //   {
  //     items: [{ conversationId, expected: {axis: n}, actual: {axis: n},
  //               delta: {axis: n}, maxDelta: n }],
  //     maxDelta: n,                  // worst per-axis delta across items
  //     meanDelta: n,                 // average per-axis delta
  //     driftFlagged: boolean,        // true if maxDelta > threshold
  //     threshold: n
  //   }
  // The UI surfaces this on the run page so reviewers can decide
  // whether to trust the run's rankings or re-evaluate.
  calibrationReport Json?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  benchmark          Benchmark           @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  providerCredential ProviderCredential  @relation("BenchmarkRunCandidate", fields: [providerCredentialId], references: [id], onDelete: Restrict)
  judgeProvider      ProviderCredential? @relation("BenchmarkRunJudge", fields: [judgeProviderCredentialId], references: [id], onDelete: Restrict)
  rubric             Rubric?             @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  ensembleGroup      EnsembleJudgeGroup? @relation("BenchmarkRunEnsembleGroup", fields: [ensembleGroupId], references: [id], onDelete: SetNull)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  results            BenchmarkResult[]

  @@index([benchmarkId, createdAt(sort: Desc)])
  @@index([benchmarkId, status])
}

model BenchmarkResult {
  id      String @id @default(cuid())
  runId   String
  // For chat-replay results, `split` is the language tag of the source conversation
  // (e.g. "ms", "en") so reporting can group by language. Defaults to "default"
  // when no natural split exists.
  split   String
  rowIdx  Int
  turnNum Int
  // function-call | chat-replay — discriminator for which fields below are populated.
  kind    String @default("function-call")

  // ── function-call fields (hf-function-call benchmarks) ────────────────────
  // Raw expected and predicted tool_calls arrays. Null for chat-replay.
  expected      Json?
  predicted     Json?
  // match | missing | extra. Null for chat-replay.
  resultType    String?
  funcMatch     Boolean?
  paramAccuracy Float?
  similarity    Float?

  // ── chat-replay fields (project-chat-replay benchmarks) ───────────────────
  // The source conversation this row was replayed from.
  conversationId    String?
  // The reference assistant turns from the original (project-generated) conversation.
  // Shape: [{ ordinal, role, content, toolCalls? }]
  referenceMessages Json?
  // The candidate model's produced assistant turns (one per replayed user turn).
  candidateMessages Json?
  // Per-validator results on the candidate output:
  //   { langid: {verdict, score, details}, register: {...}, ngram: {...} }
  validatorScores   Json?
  // Per-axis rubric scores from the LLM judge.
  //   { language_fidelity: 4, register: 5, helpfulness: 4, faithfulness: 3 }
  judgeScores       Json?
  // pass | warn | fail (judge's overall verdict).
  judgeVerdict      String?
  // Free-text reasoning from the judge, for drill-down.
  judgeRationale    String?
  // Per-turn tool-call comparison for chat-replay:
  //   [{ turn, expected, predicted, funcMatch, paramAccuracy, similarity }]
  functionCallScore Json?

  // Cost accounting (filled by both kinds — chat-replay aggregates candidate + judge).
  apiFailed Boolean  @default(false)
  tokensIn  BigInt   @default(0)
  tokensOut BigInt   @default(0)
  costUsd   Decimal? @db.Decimal(12, 6)

  // ── Multi-judge ensemble re-judge (Tier-3) ───────────────────────────────
  // Populated when an "ensemble re-judge" pass runs over a subset of a
  // completed run (typically the top-K% or a verdict filter). Each entry in
  // ensembleResult.judges has the same per-axis scores + verdict + rationale
  // as a single-judge call; the row's medianScores / worstVerdict /
  // maxDisagreement are the consensus across them.
  //
  // Shape:
  //   {
  //     judges: [
  //       { providerCredentialId, providerName, model, scores: {axis:n},
  //         verdict, rationale, tokensIn, tokensOut, costUsd, latencyMs }
  //     ],
  //     medianScores: { axis: n },
  //     worstVerdict: "pass" | "warn" | "fail",
  //     maxDisagreement: number,   // max axis-spread across judges
  //     threshold: number,         // disagreement threshold at re-judge time
  //     ensembledAt: ISO datetime
  //   }
  ensembleResult Json?
  ensembledAt    DateTime?

  createdAt DateTime @default(now())

  run BenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, split])
  @@index([runId, funcMatch])
  @@index([runId, kind])
  @@index([runId, judgeVerdict])
  @@index([runId, ensembledAt])
}

// ---------------------------------------------------------------------------
// Rubrics: reusable scoring schemes for chat-replay benchmarks. Each rubric is a
// list of axes the LLM judge scores on a 1–N scale; the run's aggregate metrics
// roll up means per axis. Users can hand-write a rubric or generate one from a
// natural-language prompt via the AI-assist `benchmark-rubric` kind.
// ---------------------------------------------------------------------------

model Rubric {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?
  // Axes the judge scores on, in display order:
  //   [{ key: "language_fidelity",
  //      name: "Language Fidelity",
  //      description: "Does the candidate stay in the target language?",
  //      scale: 5,
  //      weight: 1.0,
  //      examples?: [{ score: 5, output: "...example...", reason: "..." }, ...] }]
  axes        Json
  // System-provided default rubric. Read-only in the UI; cloned when edited.
  isPreset    Boolean @default(false)
  // Created via the AI-assist builder (vs hand-written). Used purely for analytics.
  aiDrafted   Boolean @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  benchmarks    Benchmark[]    @relation("BenchmarkDefaultRubric")
  benchmarkRuns BenchmarkRun[]

  @@unique([projectId, name])
  @@index([projectId])
}
