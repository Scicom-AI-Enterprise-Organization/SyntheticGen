# --- App ---
AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise?schema=public

# --- SyntheticGen ---
# AES-256-GCM key for provider credentials. Must be 32 bytes base64-encoded.
# Generate with: openssl rand -base64 32
# Both Next.js and the Python worker use this same key.
APP_ENCRYPTION_KEY=replace-me-32-bytes-base64

# URL of the Python synthgen FastAPI service (worker/api).
SYNTHGEN_API_URL=http://localhost:8000
# Shared secret for service-to-service calls between Next.js and Python.
SYNTHGEN_INTERNAL_TOKEN=replace-me-internal-token

# Local FS path for export artifacts. Relative paths resolve from the repo root.
EXPORTS_DIR=./storage/exports

# Worker tuning
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=4

# --- Seed admin (optional) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234

# --- Azure AD / Microsoft Entra ID ---
# AUTH_AZURE_AD_CLIENT_ID=
# AUTH_AZURE_AD_CLIENT_SECRET=
# AUTH_AZURE_AD_TENANT_ID=

# --- Google ---
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# --- Keycloak ---
# AUTH_KEYCLOAK_CLIENT_ID=
# AUTH_KEYCLOAK_CLIENT_SECRET=
# AUTH_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/your-realm

# --- SAML ---
# AUTH_SAML_ENTRY_POINT=https://idp.example.com/sso
# AUTH_SAML_ISSUER=enterprise-template
# AUTH_SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
